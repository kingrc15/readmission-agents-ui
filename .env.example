# Copy to .env in the repository root and adjust paths.
# This file is loaded with higher priority than exported env vars for the same keys (see backend/app/config.py).

# Optional — if unset or missing, backend uses data/mimicii_hf_index_hf_readmit_30d.parquet in repo root
COHORT_PARQUET_PATH="/Users/ryanking/Documents/Code/Readmit LLM UI/data/mimicii_hf_index_hf_readmit_30d.parquet"
MIMIC_IV_COHORT_PARQUET_PATH="/Users/ryanking/Documents/Code/Readmit LLM UI/data/hf_30d_manual_review_primary_hf_only.parquet"
# vLLM OpenAI API (UI backend is on PORT 8001; vLLM usually on 8000)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Alternative when tunneling: https://YOUR_SUBDOMAIN.ngrok-free.dev/v1
VLLM_MODEL=local-model
VLLM_API_KEY=EMPTY
# Exact origins allowed (browser pages). Add GitHub Pages + any site that hosts the static UI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR_USER.github.io,https://your-domain.com,https://www.your-domain.com
# OR’d with the built-in *.github.io CORS regex. Subdomains: use a pattern like the line below (single line, escape dots).
# CORS_EXTRA_ORIGIN_REGEX="https://([a-zA-Z0-9-]+\.)*your-domain\.com"
# Disable *.github.io regex (tight CORS): CORS_ALLOW_GITHUB_IO_REGEX=false
REQUEST_TIMEOUT_S=600
DEFAULT_TEMPERATURE=0.2
PORT=8001

# Optional API gate: when set, all routes except OPTIONS require Authorization: Bearer <token> or X-API-Key.
# GET /health stays open unless READMIT_HEALTH_PUBLIC=false.
# Generate: openssl rand -hex 24
# READMIT_API_TOKEN=
# READMIT_HEALTH_PUBLIC=true

# Same secret for the Vite UI (embedded in the browser bundle — trusted users / private network only).
# VITE_READMIT_API_TOKEN=

# Browser → FastAPI (HTTPS, no trailing slash). Example: https://readmit-api.chathouston-methodist.com
# VITE_API_BASE_URL=https://readmit-api.your-domain.com

# Frontend CI: set repository variable VITE_API_BASE_URL for GitHub Pages builds.
